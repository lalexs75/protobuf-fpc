<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <!-- Подключаем схему с другим префиксом -->
    <xs:include schemaLocation="common_types.xsd"/>
    
    <xs:element name="Person">
        <xs:complexType>
            <xs:sequence>
                <!-- Ссылка на тип из файла с префиксом xsd: -->
                <xs:element name="Name" type="FullNameType"/>
                <xs:element name="Age" type="xs:integer"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>