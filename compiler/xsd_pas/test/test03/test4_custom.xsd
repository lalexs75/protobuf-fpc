<?xml version="1.0" encoding="UTF-8"?>
<s:schema xmlns:s="http://www.w3.org/2001/XMLSchema">
    <s:element name="Person">
        <s:complexType>
            <s:sequence>
                <s:element name="Name" type="s:string"/>
                <s:element name="Age" type="s:integer"/>
            </s:sequence>
        </s:complexType>
    </s:element>
</s:schema>